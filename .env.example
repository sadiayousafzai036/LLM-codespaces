# Copy to .env and fill in. Only GROQ_API_KEY is strictly required.
#   cp .env.example .env

# ---------------------------------------------------------------- LLM
# Groq is OpenAI-compatible, so we use the openai SDK with a custom base_url.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1

# Check the current model list before changing these:
# https://console.groq.com/docs/models
LLM_MODEL=llama-3.3-70b-versatile
LLM_MODEL_FAST=llama-3.1-8b-instant
JUDGE_MODEL=llama-3.3-70b-versatile

# Estimated price in USD per 1M tokens, used only for the cost chart.
# The free tier costs nothing, so these default to 0. Set them to the real
# rates from https://groq.com/pricing if you move to a paid plan.
PRICE_INPUT_PER_MTOK=0.0
PRICE_OUTPUT_PER_MTOK=0.0

# ------------------------------------------------------------ Retrieval
# Which strategy the app serves. Chosen by evaluation/retrieval_eval.py.
# One of: text | text_boosted | vector | vector_full | hybrid | hybrid_rerank
#         | hybrid_rewrite
RETRIEVAL_STRATEGY=hybrid_rerank
NUM_RESULTS=5

# Which answer prompt the app serves. Chosen by evaluation/rag_eval.py.
# One of: concise | grounded | structured
PROMPT_VARIANT=grounded

# ------------------------------------------------------------- Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cooking_assistant
POSTGRES_USER=cooking
POSTGRES_PASSWORD=cooking

# ------------------------------------------------- Stack Exchange source
# Any site slug works: cooking, bicycles, gardening, diy, coffee, ...
# Changing this means re-running the ingestion pipeline.
SE_SITE=cooking
# 100 questions per page. 20 pages = 2000 questions, well inside the
# anonymous 300 requests/day quota.
SE_MAX_PAGES=20
# Optional. Raises the daily quota from 300 to 10000 requests.
# Register an app at https://stackapps.com/apps/oauth/register to get one.
SE_API_KEY=

# ------------------------------------------------------------- Embedder
EMBEDDING_MODEL_REPO=Xenova/all-MiniLM-L6-v2
EMBEDDING_MODEL_DIR=models
